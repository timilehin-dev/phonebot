# --- Gradle / Android ---
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.cxx/
.DS_Store

# --- Signed artifacts (never commit) ---
*.apk
*.aab
release/*.keystore
release/*.jks
**/*.keystore
**/*.jks
# Signed APK outputs
out/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Packaging outputs (regenerated by release/pack.py) ---
release/dist/

# --- Secrets / local endpoints (absolute no-commit) ---
**/secrets/
**/*.key
**/endpoint.json
